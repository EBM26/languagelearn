  {
   "id": "z/s/w/v",
   "title": {
    "en": "z / s / w / v",
    "he": "z / s / w / v"
   },
   "rule": {
    "en": "z = 'ts' (Zeit). s before a vowel = 'z' as in 'zoo' (Sonne). w = English 'v' (Wasser). v = usually 'f' (Vater), but 'v' in foreign words (Vase).",
    "he": "z = 'ts' (Zeit). s לפני תנועה = z כמו ב-zoo (Sonne). w = v באנגלית (Wasser). v = בדרך כלל f (Vater), אבל v במילים לועזיות (Vase)."
   },
